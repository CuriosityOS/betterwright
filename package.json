{
  "name": "betterwright",
  "version": "2.4.0",
  "description": "A persistent, policy-guarded Playwright browser for AI agents with network controls, trusted credential filling, proof screenshots, and CAPTCHA helpers.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    "./capture": {
      "types": "./types/capture.d.ts",
      "import": "./dist/src/vault-capture.js",
      "default": "./dist/src/vault-capture.js"
    },
    "./electron": {
      "types": "./types/electron.d.ts",
      "import": "./dist/src/electron.js",
      "default": "./dist/src/electron.js"
    },
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./agent": {
      "types": "./types/agent.d.ts",
      "import": "./dist/src/agent.js",
      "default": "./dist/src/agent.js"
    },
    "./auth": {
      "types": "./types/auth.d.ts",
      "import": "./dist/src/auth.js",
      "default": "./dist/src/auth.js"
    },
    "./policy": {
      "types": "./types/policy.d.ts",
      "import": "./dist/src/policy.js",
      "default": "./dist/src/policy.js"
    },
    "./vault": {
      "types": "./types/vault.d.ts",
      "import": "./dist/src/vault.js",
      "default": "./dist/src/vault.js"
    },
    "./prompt": {
      "types": "./types/prompt.d.ts",
      "import": "./dist/src/prompt.js",
      "default": "./dist/src/prompt.js"
    },
    "./pi": {
      "types": "./types/pi.d.ts",
      "import": "./dist/src/pi.js",
      "default": "./dist/src/pi.js"
    },
    "./pi-extension": {
      "types": "./types/pi-extension.d.ts",
      "import": "./dist/src/pi-extension.js",
      "default": "./dist/src/pi-extension.js"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "import": "./dist/src/worker-constants.js",
      "default": "./dist/src/worker-constants.js"
    },
    "./mcp-server": {
      "types": "./types/mcp-server.d.ts",
      "import": "./dist/src/mcp-server.js",
      "default": "./dist/src/mcp-server.js"
    },
    "./sdk": {
      "types": "./types/sdk.d.ts",
      "import": "./dist/src/sdk.js",
      "default": "./dist/src/sdk.js"
    },
    "./skills": {
      "types": "./types/skills.d.ts",
      "import": "./dist/src/skills.js",
      "default": "./dist/src/skills.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "betterwright": "dist/bin/betterwright.js"
  },
  "files": [
    "dist",
    "!dist/src/cdpfree",
    "types",
    "skills",
    "docs/*.md",
    "examples/typescript",
    "SETUP.md",
    "SKILL.md",
    "SECURITY.md",
    "README.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "LICENSE",
    "NOTICE.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build:tools": "tsc --noEmit -p tsconfig.tools.json",
    "build": "bun scripts/build.ts",
    "build:harness": "bun run build && tsc --noEmit -p tsconfig.harness.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.examples.json",
    "check:build": "bun run build && bun scripts/check-build.ts",
    "test": "bun run build:harness && bun scripts/run-unit-tests.ts --all",
    "test:unit": "bun run build:harness && bun scripts/run-unit-tests.ts",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:electron": "bun run build && electron tests/electron/reliability.mjs",
    "test:electron:packaged": "bun run build && bun tests/electron/package.mjs && electron .tmp/electron-e2e/app.asar",
    "lint": "biome ci src bin scripts research tests benchmarks examples && oxlint",
    "check:versions": "bun scripts/check-versions.ts",
    "check:package": "bun run build && bun scripts/check-package.ts",
    "release:check": "bun run check:versions && bun run lint && bun run typecheck && bun run check:build && bun run test:unit && bun run test:types && bun run check:package",
    "prepublishOnly": "bun run release:check"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/src/pi-extension.js"
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-playwright": "2.18.2",
    "playwright-core": "1.61.1",
    "tldts": "7.4.9"
  },
  "peerDependencies": {
    "electron": ">=43.4.1",
    "@anthropic-ai/sdk": ">=0.30.0",
    "@modelcontextprotocol/sdk": ">=1.13.0"
  },
  "peerDependenciesMeta": {
    "electron": { "optional": true },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "playwright",
    "browser",
    "automation",
    "agent",
    "llm",
    "ai",
    "captcha",
    "browser-use",
    "web-agent",
    "pi-package"
  ],
  "license": "MIT",
  "author": "The BetterWright Project and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterWright/betterwright.git"
  },
  "bugs": {
    "url": "https://github.com/BetterWright/betterwright/issues"
  },
  "homepage": "https://github.com/BetterWright/betterwright#readme",
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "electron": "43.4.1",
    "@types/ws": "8.5.13",
    "@biomejs/biome": "^2.5.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "^22.20.1",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "ws": "8.21.0",
    "patchright-core": "1.61.1",
    "rookie-cookies": "0.6.0"
  }
}
